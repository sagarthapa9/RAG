# Copy to `.env` and fill in. `.env` is gitignored; `.env.example` is tracked.
#
# The LLM layer is provider-agnostic: set `LLM_PROVIDER` to pick the provider,
# then give it an API key. Upload + semantic search work without any LLM config;
# only the Q&A endpoints (/api/qa/*) need it. If the chosen provider's key is
# missing, the Q&A endpoints return 503 and the rest of the API keeps working.

# --- LLM provider selection (the one switch to change providers) ---
# Supported: openai, kimi, deepseek, ollama, azure, custom
#   openai / kimi / deepseek / ollama / custom  -> OpenAI-compatible ChatOpenAI
#   azure                                        -> AzureChatOpenAI
# Default is `kimi` so existing KIMI_* setups keep working unchanged.
LLM_PROVIDER=kimi

# --- Generic overrides (optional) ---
# These apply to any provider. Most providers have a sensible default base URL
# and model, so you usually only need the API key.
# LLM_API_KEY=sk-REPLACE_ME
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# --- Provider-specific keys ---
# Set the key for whichever provider you picked above:
#   openai:  OPENAI_API_KEY=sk-...
#   kimi:    KIMI_API_KEY=sk-...
#   deepseek: DEEPSEEK_API_KEY=sk-...
#   ollama:  (no key needed — runs locally on http://localhost:11434)
#   azure:   AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT + AZURE_OPENAI_DEPLOYMENT

# --- Example: Kimi / Moonshot AI (OpenAI-compatible) ---
# Get a key from https://platform.moonshot.cn (China) or https://platform.moonshot.ai (international).
# The two platforms use separate keys and endpoints — use whichever your account is on.
# China endpoint (default). Use https://api.moonshot.ai/v1 for the international platform.
KIMI_API_KEY=sk-REPLACE_ME

# Optional overrides for Kimi (defaults shown):
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# Model name. Cheap/safe default; raise it for better answers:
#   moonshot-v1-8k / moonshot-v1-32k / moonshot-v1-128k  (classic V1)
#   kimi-k2.6, kimi-k2.7-code, kimi-k3                   (newer generation)
# Note: some newer K2/K3 models fix temperature at 1.0 and ignore LLM_TEMPERATURE.
# KIMI_MODEL=moonshot-v1-8k

# --- Example: Azure OpenAI ---
# LLM_PROVIDER=azure
# AZURE_OPENAI_API_KEY=sk-...
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=my-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-01

# --- Example: local Ollama (OpenAI-compatible, no key) ---
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# --- LLM generation tuning (read by the RAG pipeline) ---
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- RAG pipeline tuning (optional) ---
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# VECTOR_STORE_PATH=./data/chromadb
# COLLECTION_NAME=business_documents
